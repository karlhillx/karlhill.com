{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "a11y": "node scripts/run-a11y.mjs",
        "a11y:browsers": "npx playwright install chromium",
        "test:e2e": "playwright test",
        "lint": "eslint resources/js",
        "format": "prettier --write resources/js resources/css eslint.config.js",
        "format:check": "prettier --check resources/js resources/css eslint.config.js"
    },
    "dependencies": {
        "@fontsource/barlow-semi-condensed": "^5.3.0",
        "@fontsource/jetbrains-mono": "^5.3.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^10.0.1",
        "@fontsource/lato": "^5.3.0",
        "@fontsource/oswald": "^5.3.0",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.3.3",
        "concurrently": "^10.0.5",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.12.0",
        "laravel-vite-plugin": "^3.2.0",
        "pdf-lib": "^1.17.1",
        "playwright": "^1.63.0",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.3.3",
        "vite": "^8.2.2"
    }
}
