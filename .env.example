APP_NAME="Karl Hill — Staff Software Engineer"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database is optional — the site uses file cache/session and flat-file blog posts.
# DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Contact form delivery. For production use the "resend" mailer: set
# RESEND_API_KEY, verify karlhill.com in Resend, then set MAIL_MAILER=resend.
# MAIL_FROM_ADDRESS must be on that verified domain (not onboarding@resend.dev).
# Replies route to the visitor via Reply-To.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="contact@karlhill.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

VITE_APP_NAME="${APP_NAME}"

GITHUB_TOKEN=
GITHUB_USERNAME=karlhillx

# dev.to API key for `php artisan post:syndicate`. Generate at:
#   https://dev.to/settings/extensions
DEVTO_API_KEY=

# Analytics: Plausible is primary. Set GOOGLE_ANALYTICS_ENABLED=true (and
# PLAUSIBLE_ENABLED=false) only if you intentionally want GA4 instead.
PLAUSIBLE_ENABLED=true
PLAUSIBLE_DOMAIN=karlhill.com
GOOGLE_ANALYTICS_ENABLED=false
GOOGLE_ANALYTICS_MEASUREMENT_ID=G-EZZNL8KY8P

# Calendly (or Cal.com). Inline embed on /now#book + CTAs site-wide.
BOOKING_URL=https://calendly.com/karlhill
BOOKING_LABEL="Book a conversation"

# Optional Cloudflare Turnstile (contact form). Both keys required to enable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

PRODUCTION=karlhill.com
SSH_USER=karl

# Web Push (php artisan push:vapid). Both keys required to enable subscribe UI.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:karlhillx@gmail.com"

# Origin 103 Early Hints (FrankenPHP / HTTP/2+). Link preloads already emit
# without this; set true only when the SAPI can flush a 103.
EARLY_HINTS=false

# Optional platform surfaces (default off). Set true only for clusters you operate.
WEBMENTION_ENABLED=false
REPORTING_ENABLED=false
COMPRESSION_DICTIONARY=false
CONTENT_CREDENTIALS=false
WEBGPU_FLOOD=false
