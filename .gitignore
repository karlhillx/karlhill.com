# Laravel / PHP project .gitignore
# Source of truth: lynx-devops/templates/laravel.gitignore

# Dependencies
/vendor
/node_modules
/.venv

# Environment
.env
.env.backup
.env.production
/auth.json

# Laravel build / runtime
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail

# PHPUnit / IDE
.phpactor.json
.phpunit.result.cache
/.phpunit.cache
/.fleet
/.idea
/.nova
/.vscode
/.zed
/.cursor
/AGENTS.md
/CLAUDE.md
/GEMINI.md

# Homestead
Homestead.json
Homestead.yaml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Accidental media dumps at repo root (client assets under clients/ are fine)
/*.mp4
/*.mov
/*.webm

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Generated Dry Standard catalog (rebuild with php artisan dry-standard:build)
/clients/the-dry-standard/data/catalog.sqlite
/clients/the-dry-standard/data/catalog.sqlite-journal
/clients/the-dry-standard/data/catalog.sqlite-wal
/clients/the-dry-standard/data/catalog.sqlite-shm

# Optional no-db feature stores
/storage/app/webmentions
/storage/app/push
/storage/app/reports
/storage/app/dict
/public/files/content-credentials.json
/public/files/*.c2pa.json
README-INSTALL.md
docs/context-private/career-history.md
docs/context-private/corrections.md
docs/context-private/current-goals.md
docs/context-private/engineering-work.md
docs/context-private/music-history.md
docs/context-private/profile.md
docs/context-private/source-of-truth.md
docs/context-private/website-content-strategy.md
